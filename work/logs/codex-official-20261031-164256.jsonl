{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json,re\nslugs=['yangming-action-coach','xiaomi-emotional-companion']\nrequired=['一句话主餐','输入','核心判断','编号工作流','直接交付与下一步','外部参考与延展']\nfor s in slugs:\n p=Path(s);t=(p/'SKILL.md').read_text();r=(p/'README.md').read_text()\n assert len(t.splitlines())>=120 and len(r.splitlines())>=40\n assert all(x in t for x in required)\n assert len(re.findall(r'\"'^## '\"',r,re.M))==6\n assert len(re.findall(r'\"'^### [1-6]'\"\\\\. ',t,re.M))==6\n for target in re.findall(r'\\\\]\\\\((references/[\"'^)]+)'\"\\\\)',t): assert (p/target).is_file(),target\n assert '模拟' in (p/'references/review-validation.md').read_text()\n print(s,'PASS','SKILL',len(t.splitlines()),'README',len(r.splitlines()),'六段结构、工作流、示例链接通过')\nf=Path('.skill-production/review-manifest.json');d=json.loads(f.read_text())\nfor x in d:\n if x['slug'] in slugs:\n  assert x['status']=='pending'\n  x.update(status='reviewed',verdict='reworked',changes={'yangming-action-coach':'补齐无权限与触发失败分支，保存模拟行动卡验证','xiaomi-emotional-companion':'补齐拒绝追问、纠正与撤回建议，保存边界验证'}[x['slug']])\n  assert len(x['changes'])<=40\nf.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\\\\n')\nprint('清单更新完成')\nPY\npython3 -c \\\"import json;d=json.load(open('.skill-production/review-manifest.json'));print(sum(1 for x in d if x['status']=='reviewed'))\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
