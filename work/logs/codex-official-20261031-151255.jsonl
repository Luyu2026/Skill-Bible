{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport re, json\nslugs=['relationship-repair-plan','bazi-year-reflection','odyssey-life-options','life-design-prototype','voiceover-production-kit','stepwise-problem-tutor']\nheads=['一句话主餐','输入','核心判断','编号工作流','直接交付与下一步','外部参考与延展']\nrheads=['它适合什么场景','它解决什么','一个重要机制','你会拿到什么','怎么开始','可直接复制的调用模板']\nfor s in slugs:\n p=Path(s); skill=(p/'SKILL.md').read_text(); read=(p/'README.md').read_text(); demo=(p/'references/review-validation.md').read_text()\n assert len(skill.splitlines())>=120 and len(read.splitlines())>=40\n assert all('## '+h in skill for h in heads)\n assert re.findall(r'\"'^## (.*)$'\"',read,re.M)==rheads\n assert len(re.findall(r'\"'^### [1-6]'\"\\\\. ',skill,re.M))==6\n assert '保留本步输入与结论的对应关系' not in skill\n assert '纯模拟' in demo and '核验：' in demo\n for link in re.findall(r'\\\\]\\\\((references/[\"'^)]+)'\"\\\\)',skill): assert (p/link).exists()\n print(s, 'PASS',len(skill.splitlines()),len(read.splitlines()))\n# Independent check of the worked equation and transfer answer.\nassert 2*(7-3)==8 and 3*(6-2)==12\nassert 20+10+10+20==60 and 45+15+30+30==120\nassert 12/240*60+1==4 and 12/180*60+3==7\nprint('算例、体验时间上限、配音估时复核通过')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
