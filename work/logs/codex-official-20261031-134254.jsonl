{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\n# -*- coding: utf-8 -*-\nfrom pathlib import Path\nimport json,shutil\nslugs=['fiction-scene-starter','adhd-daily-start','serial-chapter-draft','moments-caption-writer','bazi-chart-reading','double-color-picker']\nanswers={\n'fiction-scene-starter':('真实：有设定却写不出可续写开头；输入设定或原稿，产出连续场景。','完整：716字模拟开场包含尝试、受阻、选择、后果及两条续写分支。','补齐完整开场示例、改稿分支与具体判断'),\n'adhd-daily-start':('真实：有硬截止但未启动；输入待办、时段与精力，产出三步和恢复卡。','完整：60分钟模拟输入分配45分钟行动及15分钟缓冲，并演示仅余10分钟的续接降级。','细化截止冲突、启动失败与中断续接'),\n'serial-chapter-draft':('真实：需要首章或续章；输入设定或前文，产出2200—2800字完整正文。','完整：完整模拟正文实数2286字符，事件闭环、账本、下一章起点齐备；无工具时标长度待验。','补计数边界、连续性取舍与完整单章验收'),\n'moments-caption-writer':('真实：有照片或草稿但不会配文；输入已发生事实，产出三版及主推。','完整：三版共享事实底稿，修复旧演示新增绕路行为；反馈后给不拟人的直接成稿。','纠正示例编造经历，细化事实与口吻分支'),\n'bazi-chart-reading':('真实：用户看不懂已有排盘；输入给定四柱或出生记录，产出来源状态与术语说明。','完整：模拟给定盘逐柱注明未核验，不虚算日柱；列继续核验最少信息和只解释术语路线。','细化历法边界、给定盘状态与核验降级'),\n'double-color-picker':('真实：需要合法号码或检查整注重复；输入注数、号码限制，产出号码与校验。','完整：实际运行生成三注；容量、红蓝同值、重复、越界、必选及全候选穷举对照通过。当前规则未核验。','新增可运行随机校验、容量拒绝与边界验收')}\nfor s in slugs:\n p=Path(s,'references/example.md');t=p.read_text();a,b,_=answers[s];t+='\\\\n## 示例验收与边界\\\\n\\\\n'+a+'\\\\n\\\\n'+b+'\\\\n';p.write_text(t)\n# Keep generated runtime resources clean.\np=Path('double-color-picker/references/__pycache__')\nif p.exists():shutil.rmtree(p)\np=Path('.skill-production/review-manifest.json');m=json.loads(p.read_text())\nfor x in m:\n if x['slug'] in slugs:\n  assert x['status']=='pending'\n  x.update(status='reviewed',verdict='reworked',changes=answers[x['slug']][2]);assert len(x['changes'])<=40\np.write_text(json.dumps(m,ensure_ascii=False,indent=2)+'\\\\n')\nresult=Path('fiction-scene-starter/references/batch-review-result.md')\ntext='# 本批复审结果\\\\n\\\\n结果清单：\"'`.skill-production/review-manifest.json`。本批6项，reworked 6；保留全部slug与定位。'\"\\\\n\\\\n'\nfor s in slugs:\n a,b,c=answers[s];text+=f'## {s}：reworked\\\\n\\\\n- 真实问题：{a}\\\\n- 完整详尽：{b}\\\\n- 返修：{c}。\\\\n\\\\n'\ntext+='全部SKILL不少于120行，README不少于40行且六段，本地引用存在。小说开场716字符，连载单章2286字符。\\\\n本次验证使用明确模拟材料；不声称真实用户反馈、医学疗效、未来预测或中奖能力。\\\\n原demo.md不在允许修改范围内，未改；README统一指向已校正的references/example.md。\\\\n累计复审：'+str(sum(x['status']=='reviewed' for x in m))+'。\\\\n'\nresult.write_text(text)\nprint('结果文件：'+str(result))\nfor s in slugs:print(s+' SKILL/README行数：'+str(len(Path(s,'SKILL.md').read_text().splitlines()))+'/'+str(len(Path(s,'README.md').read_text().splitlines())))\nPY\npython3 -c \\\"import json;d=json.load(open('.skill-production/review-manifest.json'));print(sum(1 for x in d if x['status']=='reviewed'))\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
