{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport json,re,math\nfrom pathlib import Path\np=Path('.skill-production/review-manifest.json');d=json.loads(p.read_text())\nbatch=[x for x in d if x['status']=='pending'][:6]\nexpected=['moments-caption-studio','life-choice-simulator','resume-proofread-layout','math-solution-coach','physics-problem-coach','moments-natural-rewrite']\nassert [x['slug'] for x in batch]==expected,'清单已发生并发变化'\nheads=['适合什么场景','解决什么','一个重要机制','你会拿到什么','怎么开始','可直接复制的调用模板']\nfor x in batch:\n root=Path(x['slug']);s=(root/'SKILL.md').read_text();r=(root/'README.md').read_text();v=(root/'references/review-validation.md').read_text()\n assert len(s.splitlines())>=120 and len(r.splitlines())>=40\n assert re.findall(r'\"'^## (.+)$'\"',r,re.M)==heads\n for h in ['一句话主餐','输入','核心判断','编号工作流','直接交付与下一步','外部参考与延展']:assert '## '+h in s\n assert len(re.findall(r'\"'^### '\"\\\\d+\\\\.',s,re.M))==7\n for content in [s,r]:\n  for link in re.findall(r'\\\\]\\\\(([\"'^)]+)'\"\\\\)',content):\n   if not link.startswith(('https://','http://','#')):assert (root/link.split('#')[0]).exists(),link\n assert '普通聊天容易直接给出貌似完整的答案' not in s\n assert '真实问题：是' in v and '完整详尽：' in v and '输入（纯模拟）' in v\n print(x['slug']+': 行数、六段README、工作流、引用与运行记录通过')\nassert [x for x in [0,3] if math.sqrt(x+1)==x-1]==[3]\nassert [x for x in [0,3] if math.sqrt(x+1)==1-x]==[0]\nassert (10-0.2*2*10)/2==3\nassert 3<=0.2*2*10\nassert 4+2<=6 and 2+1<=3 and 1+2<=3\nprint('数理案例及分支时间账复算通过；文案事实与反馈路径已手工回查。')\nchanges={\n'moments-caption-studio':'细化事实卡、三版差异与邀请边界，补运行验证',\n'life-choice-simulator':'补资源账、模式停止点与续玩验收，修假设边界',\n'resume-proofread-layout':'补排版参数、事实分级与文件验收，验证降级交付',\n'math-solution-coach':'明确提示停止点与等价变形检查，验证增根与变式',\n'physics-problem-coach':'补模型选择和提示边界，验证静滑摩擦及量纲',\n'moments-natural-rewrite':'补最少改动和事实回查，验证语气反馈与邀请入口'}\nfor x in batch:\n x.update(status='reviewed',verdict='reworked',changes=changes[x['slug']])\n assert len(x['changes'])<=40\np.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\\\\n')\nprint('结果清单：'+str(p)+'；本批 reworked=6')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
