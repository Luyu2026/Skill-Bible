{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill-Bible anonymous run event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "occurred_at", "skill_id", "skill_version", "event_type", "agent_family", "telemetry_version"],
  "properties": {
    "event_id": { "type": "string", "pattern": "^[a-f0-9-]{16,64}$" },
    "occurred_at": { "type": "string", "format": "date-time" },
    "skill_id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
    "skill_version": { "type": "string", "maxLength": 64 },
    "event_type": { "enum": ["started", "completed", "failed", "feedback"] },
    "agent_family": { "enum": ["codex", "claude", "workbuddy", "other", "unknown"] },
    "duration_bucket": { "enum": ["under-1m", "1-5m", "5-15m", "15m-plus", "unknown"] },
    "error_code": { "type": "string", "maxLength": 64 },
    "feedback": { "enum": ["helpful", "partly_helpful", "not_helpful"] },
    "installation_id": { "type": "string", "pattern": "^[a-f0-9-]{16,64}$" },
    "telemetry_version": { "const": "1" }
  }
}
